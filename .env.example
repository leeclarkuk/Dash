# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Public URL of this instance (used for GitHub OAuth callback)
APP_URL=http://localhost:3000

# GitHub OAuth App. Leave empty to use demo sign-in only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Allow the seeded demo organisation and one-click demo sign-in.
# Defaults to true in development, false in production.
ALLOW_DEMO_AUTH=true

# Optional. Postgres connection string for production.
# If unset, Dash uses an embedded Postgres (PGlite) at .data/dash.
# DATABASE_URL=postgres://dash:dash@localhost:5432/dash
